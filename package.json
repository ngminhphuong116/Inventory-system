{
  "name": "inventory-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "analyze": "tsc -b && cross-env ANALYZE=true vite build",
    "lint": "eslint .",
    "test": "vitest run --exclude functions/lib/** --exclude tests/database.rules.test.ts",
    "test:rules": "firebase emulators:exec --project demo-inventory --only database \"vitest run tests/database.rules.test.ts\"",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "production:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/production-backup.ps1",
    "production:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/production-audit.ps1",
    "production:deploy:rules": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-production-rules.ps1",
    "preview": "vite preview",
    "electron:start": "electron .",
    "clean:electron": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-electron.ps1",
    "electron:build": "node scripts/build-release.mjs",
    "electron:build:clean": "npm run clean:electron && npm run electron:build",
    "smoke:receipt": "node scripts/smoke-sales-receipt.mjs",
    "smoke:receipt:import": "node scripts/smoke-sales-receipt.mjs --kind=import",
    "smoke:receipt:export": "node scripts/smoke-sales-receipt.mjs --kind=export",
    "release:win": "node scripts/build-release.mjs",
    "release:source": "node scripts/export-source.mjs",
    "release:checksums": "node scripts/release-checksums.mjs",
    "release:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-release-assets.ps1"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "antd": "^6.4.4",
    "exceljs": "^4.4.0",
    "firebase": "^12.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^7.0.3",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.24.0",
    "globals": "^17.6.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4",
    "esbuild": "0.28.1",
    "@electron/asar": "3.4.1"
  },
  "description": "Ứng dụng quản lý kho hàng và bán hàng POS trên Windows",
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
